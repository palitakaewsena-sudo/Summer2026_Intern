# Ignore all subdirectories generated by CST Studio Suite (containing meshes, history, results)
cst_models/unit_cell/unit_cell_base_20GHz/
cst_models/unit_cell/unit_cell_ma4agp907/
cst_models/unit_cell/unit_cell_mlp7140/
cst_models/full_array_8x8/array_8x8_ma4agp907/
cst_models/full_array_8x8/array_8x8_mlp7140/

# Ignore typical CST temporary and backup files
*.bak
*.bak[0-9]*
*.log
*.dds
*.DS_Store
Thumbs.db

# Ignore MATLAB local user configurations and locks
.mlx.lock
*.asv
